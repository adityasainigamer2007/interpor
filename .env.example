# ─────────────────────────────────────────────────────────────
# Ayava Creatives — Intern Portal
# Copy to .env.local (development) or set these on your server.
# ─────────────────────────────────────────────────────────────

# REQUIRED. Signs session cookies and hashes email codes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this signs everyone out.
AUTH_SECRET=

# REQUIRED. The public URL of the portal, used to build invitation and
# password-reset links. Read at RUNTIME, so the same build works anywhere.
# Get this wrong and everyone receives links pointing at the wrong host.
APP_URL=https://portal.ayavacreatives.com

# REQUIRED for first run only. Protects the /setup page that creates the very
# first administrator. At least 8 characters. The page seals itself for good
# once an account exists, so you can remove this afterwards.
SETUP_TOKEN=

# ─────────────────────────────────────────────────────────────
# Email (SMTP) — REQUIRED in production.
# Without it, verification codes and invitations cannot be delivered and the
# portal refuses to send rather than failing silently.
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=portal@ayavacreatives.com
SMTP_PASS=
MAIL_FROM="Ayava Creatives <portal@ayavacreatives.com>"

# ─────────────────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────────────────
# SQLite database file. Defaults to ./data/portal.db.
# Point this at a path on persistent disk that is included in your backups.
# DATABASE_FILE=/var/lib/ayava-portal/portal.db
