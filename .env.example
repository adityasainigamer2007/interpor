# Secret used to sign session cookies and hash email codes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-me-with-a-32-byte-hex-string

# Where the portal is served from (used in invitation + reset links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: path to the JSON datastore (defaults to ./data/db.json)
# DATA_FILE=./data/db.json
